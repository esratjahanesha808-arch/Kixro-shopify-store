{%- comment -%}
  Outputs normalized category slug for product: shoes | boots | loafers | sandals
  Accepts: product
{%- endcomment -%}
{%- liquid
  assign cat = ''

  capture is_boots
    render 'kixro-category-match', product: product, category: 'boots'
  endcapture
  if is_boots contains 'true'
    assign cat = 'boots'
  endif

  if cat == blank
    capture is_loafers
      render 'kixro-category-match', product: product, category: 'loafers'
    endcapture
    if is_loafers contains 'true'
      assign cat = 'loafers'
    endif
  endif

  if cat == blank
    capture is_sandals
      render 'kixro-category-match', product: product, category: 'sandals'
    endcapture
    if is_sandals contains 'true'
      assign cat = 'sandals'
    endif
  endif

  if cat == blank
    capture is_shoes
      render 'kixro-category-match', product: product, category: 'shoes'
    endcapture
    if is_shoes contains 'true'
      assign cat = 'shoes'
    endif
  endif

  if cat == blank
    assign type_down = product.type | downcase
    if type_down contains 'boot'
      assign cat = 'boots'
    elsif type_down contains 'loafer'
      assign cat = 'loafers'
    elsif type_down contains 'sandal' or type_down contains 'clog' or type_down contains 'slide'
      assign cat = 'sandals'
    elsif type_down contains 'shoe'
      assign cat = 'shoes'
    endif
  endif

  assign cat_tokens = cat

  capture is_new
    render 'kixro-category-match', product: product, category: 'new-arrivals'
  endcapture
  if is_new contains 'true'
    assign cat_tokens = cat_tokens | append: ' new-arrivals'
  endif

  capture is_best
    render 'kixro-category-match', product: product, category: 'best-sellers'
  endcapture
  if is_best contains 'true'
    assign cat_tokens = cat_tokens | append: ' best-sellers'
  endif

  capture is_trend
    render 'kixro-category-match', product: product, category: 'trending-now'
  endcapture
  if is_trend contains 'true'
    assign cat_tokens = cat_tokens | append: ' trending-now'
  endif

  capture is_ess
    render 'kixro-category-match', product: product, category: 'kixro-essentials'
  endcapture
  if is_ess contains 'true'
    assign cat_tokens = cat_tokens | append: ' kixro-essentials essentials'
  endif
-%}
{{- cat_tokens | strip -}}

