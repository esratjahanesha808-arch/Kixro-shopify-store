{%- comment -%}
  Kixro desktop category filter: Shoes, Boots, Loafers, Sandals, New Arrivals, Best Sellers, Trending Now, Essentials.
{%- endcomment -%}

{%- liquid
  capture kixro_category_param_capture
    render 'kixro-query-param', key: 'category'
  endcapture
  assign active_cat = kixro_virtual_category | default: kixro_category_param_capture | strip | downcase

  assign shoes_count = 0
  assign boots_count = 0
  assign loafers_count = 0
  assign sandals_count = 0
  assign new_arrivals_count = 0
  assign best_sellers_count = 0
  assign trending_count = 0
  assign essentials_count = 0
  assign all_count = 0

  for prod in collections.all.products limit: 250
    assign all_count = all_count | plus: 1
    capture p_cat
      render 'kixro-product-category', product: prod
    endcapture
    assign p_cat_clean = p_cat | strip
    if p_cat_clean contains 'shoes'
      assign shoes_count = shoes_count | plus: 1
    endif
    if p_cat_clean contains 'boots'
      assign boots_count = boots_count | plus: 1
    endif
    if p_cat_clean contains 'loafers'
      assign loafers_count = loafers_count | plus: 1
    endif
    if p_cat_clean contains 'sandals'
      assign sandals_count = sandals_count | plus: 1
    endif
    if p_cat_clean contains 'new-arrivals'
      assign new_arrivals_count = new_arrivals_count | plus: 1
    endif
    if p_cat_clean contains 'best-sellers'
      assign best_sellers_count = best_sellers_count | plus: 1
    endif
    if p_cat_clean contains 'trending-now'
      assign trending_count = trending_count | plus: 1
    endif
    if p_cat_clean contains 'kixro-essentials' or p_cat_clean contains 'essentials'
      assign essentials_count = essentials_count | plus: 1
    endif
  endfor
-%}

<details
  id="Details-kixro-category-{{ section.id }}"
  class="kixro-category-filter facets__disclosure-vertical"
  data-index="kixro-category"
  data-kixro-filter-mode="client"
  open
>
  <summary class="kixro-category-filter__heading facets__summary caption-large focus-offset">
    <span>Category</span>
    <svg class="kixro-category-filter__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  </summary>
  <div class="kixro-category-filter__panel facets__display-vertical">
    <ul class="kixro-category-filter__list list-unstyled" role="list">
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == blank %} is-active{% endif %}"
          data-kixro-category-btn=""
          data-category-label=""
          aria-pressed="{% if active_cat == blank %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">All Categories</span>
          <span class="kixro-category-filter__count">({{ all_count }})</span>
        </button>
      </li>
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'shoes' %} is-active{% endif %}"
          data-kixro-category-btn="shoes"
          data-category-label="Shoes"
          aria-pressed="{% if active_cat == 'shoes' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Shoes</span>
          <span class="kixro-category-filter__count">({{ shoes_count }})</span>
        </button>
      </li>
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'boots' %} is-active{% endif %}"
          data-kixro-category-btn="boots"
          data-category-label="Boots"
          aria-pressed="{% if active_cat == 'boots' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Boots</span>
          <span class="kixro-category-filter__count">({{ boots_count }})</span>
        </button>
      </li>
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'loafers' %} is-active{% endif %}"
          data-kixro-category-btn="loafers"
          data-category-label="Loafers"
          aria-pressed="{% if active_cat == 'loafers' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Loafers</span>
          <span class="kixro-category-filter__count">({{ loafers_count }})</span>
        </button>
      </li>
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'sandals' %} is-active{% endif %}"
          data-kixro-category-btn="sandals"
          data-category-label="Sandals"
          aria-pressed="{% if active_cat == 'sandals' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Sandals</span>
          <span class="kixro-category-filter__count">({{ sandals_count }})</span>
        </button>
      </li>
      {%- if new_arrivals_count > 0 -%}
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'new-arrivals' %} is-active{% endif %}"
          data-kixro-category-btn="new-arrivals"
          data-category-label="New Arrivals"
          aria-pressed="{% if active_cat == 'new-arrivals' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">New Arrivals</span>
          <span class="kixro-category-filter__count">({{ new_arrivals_count }})</span>
        </button>
      </li>
      {%- endif -%}
      {%- if best_sellers_count > 0 -%}
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'best-sellers' %} is-active{% endif %}"
          data-kixro-category-btn="best-sellers"
          data-category-label="Best Sellers"
          aria-pressed="{% if active_cat == 'best-sellers' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Best Sellers</span>
          <span class="kixro-category-filter__count">({{ best_sellers_count }})</span>
        </button>
      </li>
      {%- endif -%}
      {%- if trending_count > 0 -%}
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'trending-now' or active_cat == 'trending' %} is-active{% endif %}"
          data-kixro-category-btn="trending-now"
          data-category-label="Trending Now"
          aria-pressed="{% if active_cat == 'trending-now' or active_cat == 'trending' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Trending Now</span>
          <span class="kixro-category-filter__count">({{ trending_count }})</span>
        </button>
      </li>
      {%- endif -%}
      {%- if essentials_count > 0 -%}
      <li class="kixro-category-filter__item">
        <button
          type="button"
          class="kixro-category-filter__btn{% if active_cat == 'kixro-essentials' or active_cat == 'essentials' %} is-active{% endif %}"
          data-kixro-category-btn="kixro-essentials"
          data-category-label="Curated Essentials"
          aria-pressed="{% if active_cat == 'kixro-essentials' or active_cat == 'essentials' %}true{% else %}false{% endif %}"
        >
          <span class="kixro-category-filter__radio"></span>
          <span class="kixro-category-filter__name">Curated Essentials</span>
          <span class="kixro-category-filter__count">({{ essentials_count }})</span>
        </button>
      </li>
      {%- endif -%}
    </ul>
  </div>
</details>
