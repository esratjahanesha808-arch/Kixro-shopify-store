{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-search section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="kixro-container">
    <div class="kixro-page-header kixro-page-header--compact">
      <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
      <h1 class="kixro-page-header__title">
        {%- if search.performed -%}
          {{ section.settings.results_heading }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="kixro-search__form">
      <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'general.search.search' | t | default: 'Search' }}</label>
      <input
        class="kixro-search__input"
        id="Search-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="kixro-btn kixro-btn--primary">{{ section.settings.button_label }}</button>
    </form>

    {%- if search.performed -%}
      {%- assign product_results = search.results | where: 'object_type', 'product' -%}

      {%- if product_results.size > 0 -%}
        <p class="kixro-search__count">
          {{ product_results.size }}
          {% if product_results.size == 1 %} result{% else %} results{% endif %}
          for “{{ search.terms | escape }}”
        </p>

        <div class="kixro-search__grid kixro-product-grid kixro-product-grid--open">
          {%- for item in product_results -%}
            {% render 'product-card', product: item %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="kixro-search__empty">
          <h2 class="kixro-search__empty-title">{{ section.settings.empty_heading }}</h2>
          <p class="kixro-search__empty-text">{{ section.settings.empty_text }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="kixro-btn kixro-btn--primary">
            {{ section.settings.empty_button }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="kixro-search__hint">{{ section.settings.hint_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-search-results.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-search-results.settings.eyebrow.label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-search-results.settings.heading.label",
      "default": "Find your next pair"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "t:sections.kixro-search-results.settings.results_heading.label",
      "default": "Search Results"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:sections.kixro-search-results.settings.placeholder.label",
      "default": "Search products..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.kixro-search-results.settings.button_label.label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "t:sections.kixro-search-results.settings.hint_text.label",
      "default": "Search our full collection."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:sections.kixro-search-results.settings.empty_heading.label",
      "default": "No products found"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "t:sections.kixro-search-results.settings.empty_text.label",
      "default": "Try a different search term or browse the full collection."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "t:sections.kixro-search-results.settings.empty_button.label",
      "default": "Shop All"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-search-results.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-search-results.settings.padding_bottom.label",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-search-results.presets.name"
    }
  ]
}
{% endschema %}
