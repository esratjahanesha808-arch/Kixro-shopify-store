{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-search section-{{ section.id }}-padding">
  <div class="kixro-container">
    <div class="kixro-page-header kixro-page-header--compact">
      <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
      <h1 class="kixro-page-header__title">
        {%- if search.performed -%}
          {{ section.settings.results_heading }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="kixro-search__form">
      <label class="visually-hidden" for="KixroSearchInput">Search</label>
      <input
        class="kixro-search__input"
        id="KixroSearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.placeholder }}"
        autocomplete="off"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="kixro-btn kixro-btn--primary">{{ section.settings.button_label }}</button>
    </form>

    {%- if search.performed -%}
      {%- assign product_results = search.results | where: 'object_type', 'product' -%}

      {%- if product_results.size > 0 -%}
        <p class="kixro-search__count">
          {{ product_results.size }}
          {% if product_results.size == 1 %} result{% else %} results{% endif %}
          for “{{ search.terms | escape }}”
        </p>

        <div class="kixro-search__grid kixro-product-grid kixro-product-grid--open">
          {%- for item in product_results -%}
            {% render 'product-card', product: item %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="kixro-search__empty">
          <h2 class="kixro-search__empty-title">{{ section.settings.empty_heading }}</h2>
          <p class="kixro-search__empty-text">{{ section.settings.empty_text }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="kixro-btn kixro-btn--primary">
            {{ section.settings.empty_button }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="kixro-search__hint">{{ section.settings.hint_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kixro Search Results",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next pair"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results heading",
      "default": "Search Results"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search shoes, boots, loafers..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Search button",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "hint_text",
      "label": "Hint text",
      "default": "Search our full collection of premium footwear."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "No products found"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty text",
      "default": "Try a different search term or browse the full collection."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "Empty button",
      "default": "Shop All Shoes"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [{ "name": "Kixro Search Results" }]
}
{% endschema %}
