{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-cart section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="kixro-container">
    <div class="kixro-page-header kixro-page-header--compact kixro-cart__header">
      <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
      <h1 class="kixro-page-header__title">{{ section.settings.heading }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="kixro-cart__continue">{{ section.settings.continue_label }}</a>
    </div>

    {%- if cart == empty -%}
      <div class="kixro-cart__empty">
        <h2 class="kixro-cart__empty-title">{{ section.settings.empty_heading }}</h2>
        <p class="kixro-cart__empty-text">{{ section.settings.empty_text }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="kixro-btn kixro-btn--primary kixro-btn--lg">
          {{ section.settings.empty_button }}
        </a>
      </div>
    {%- else -%}
      <div class="kixro-cart__status visually-hidden" aria-live="polite" aria-atomic="true" data-cart-live-region></div>
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="kixro-cart__form">
        <div class="kixro-cart__layout">
          <div class="kixro-cart__items">
            {%- for item in cart.items -%}
              <div class="kixro-cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                <a href="{{ item.url }}" class="kixro-cart-item__media">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 240 }}"
                      alt="{{ item.image.alt | escape }}"
                      loading="lazy"
                      width="120"
                      height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                    >
                  {%- endif -%}
                </a>

                <div class="kixro-cart-item__details">
                  <a href="{{ item.url }}" class="kixro-cart-item__title">{{ item.product.title | escape }}</a>

                  {%- unless item.product.has_only_default_variant -%}
                    <p class="kixro-cart-item__variant">
                      {%- for option in item.options_with_values -%}
                        {{ option.name }}: {{ option.value }}{%- unless forloop.last -%} · {%- endunless -%}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}

                  {%- for property in item.properties -%}
                    {%- if property.last != blank and property.first.first != '_' -%}
                      <p class="kixro-cart-item__property">{{ property.first }}: {{ property.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}

                  <p class="kixro-cart-item__price">{{ item.final_line_price | money }}</p>

                  <div class="kixro-cart-item__actions">
                    <div class="kixro-cart-qty" data-kixro-qty-stepper>
                      <button
                        type="button"
                        class="kixro-cart-qty__btn"
                        data-qty-minus
                        aria-label="Decrease quantity for {{ item.product.title | escape }}"
                      >
                        −
                      </button>
                      <input
                        class="kixro-cart-qty__input"
                        type="number"
                        name="updates[]"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        value="{{ item.quantity }}"
                        min="1"
                        inputmode="numeric"
                        aria-label="Quantity for {{ item.product.title | escape }}"
                        readonly
                      >
                      <button
                        type="button"
                        class="kixro-cart-qty__btn"
                        data-qty-plus
                        aria-label="Increase quantity for {{ item.product.title | escape }}"
                      >
                        +
                      </button>
                    </div>
                    <a href="{{ item.url_to_remove }}" class="kixro-cart-item__remove">{{ section.settings.remove_label }}</a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          <div class="kixro-cart__summary-sticky">
            <aside class="kixro-cart__summary">
              <h2 class="kixro-cart__summary-title">{{ section.settings.summary_heading }}</h2>

              <div class="kixro-cart__summary-row">
                <span>{{ section.settings.subtotal_label }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>

              {%- if section.settings.show_note -%}
                <label class="kixro-contact__label" for="CartNote">{{ section.settings.note_label }}</label>
                <textarea class="kixro-contact__input kixro-contact__textarea" name="note" id="CartNote" rows="3">{{ cart.note }}</textarea>
              {%- endif -%}

              <div class="kixro-cart__summary-actions">
                <button type="submit" name="update" class="kixro-btn kixro-btn--secondary" data-cart-update>
                  {{ section.settings.update_label }}
                </button>
                <button type="submit" name="checkout" class="kixro-btn kixro-btn--primary kixro-btn--lg">
                  {{ section.settings.checkout_label }}
                </button>
              </div>

              {%- if section.settings.summary_text != blank -%}
                <p class="kixro-cart__summary-note">{{ section.settings.summary_text }}</p>
              {%- endif -%}
            </aside>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'kixro-cart-page.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.kixro-cart-page.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-cart-page.settings.eyebrow.label",
      "default": "Your Bag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-cart-page.settings.heading.label",
      "default": "Shopping Cart"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "t:sections.kixro-cart-page.settings.continue_label.label",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "t:sections.kixro-cart-page.settings.remove_label.label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "t:sections.kixro-cart-page.settings.summary_heading.label",
      "default": "Order Summary"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "t:sections.kixro-cart-page.settings.subtotal_label.label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "t:sections.kixro-cart-page.settings.update_label.label",
      "default": "Update Cart"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "t:sections.kixro-cart-page.settings.checkout_label.label",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "t:sections.kixro-cart-page.settings.summary_text.label",
      "default": "Taxes and shipping calculated at checkout."
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:sections.kixro-cart-page.settings.show_note.label",
      "default": false
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "t:sections.kixro-cart-page.settings.note_label.label",
      "default": "Order note"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:sections.kixro-cart-page.settings.empty_heading.label",
      "default": "Your cart is empty"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "t:sections.kixro-cart-page.settings.empty_text.label",
      "default": "Looks like you haven't added anything yet. Explore our collection and find your perfect pair."
    },
    {
      "type": "text",
      "id": "empty_button",
      "label": "t:sections.kixro-cart-page.settings.empty_button.label",
      "default": "Start Shopping"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-cart-page.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-cart-page.settings.padding_bottom.label",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-cart-page.presets.name"
    }
  ]
}
{% endschema %}
