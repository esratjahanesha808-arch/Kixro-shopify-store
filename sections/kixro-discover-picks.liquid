<div class="kixro-section color-{{ section.settings.color_scheme }}" style="background:var(--kixro-bg);">
  <div class="kixro-container">

    <div class="kixro-section-header">
      <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
      <h2 class="kixro-section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="kixro-section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="kixro-picks-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pick_image    = block.settings.image
          assign pick_fallback = block.settings.fallback_image
          assign pick_label    = block.settings.label
          assign pick_title    = block.settings.title
          assign pick_raw_url  = block.settings.link | default: routes.all_products_collection_url
          assign pick_btn      = block.settings.btn_label | default: 'Shop Now'
        -%}
        {%- capture pick_url_capture -%}{% render 'kixro-category-url', link: pick_raw_url, label: pick_title %}{%- endcapture -%}
        {%- assign pick_url = pick_url_capture | strip -%}

        <a
          href="{{ pick_url }}"
          class="kixro-pick-card"
          aria-label="{{ pick_title | escape }}"
          style="position:relative;"
          {{ block.shopify_attributes }}
        >
          {%- if pick_image != blank -%}
            <img
              src="{{ pick_image | image_url: width: 900 }}"
              srcset="{{ pick_image | image_url: width: 600 }} 600w,
                      {{ pick_image | image_url: width: 900 }} 900w,
                      {{ pick_image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              alt="{{ pick_title | escape }}"
              width="{{ pick_image.width }}"
              height="{{ pick_image.height }}"
              loading="lazy"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
            >
          {%- elsif pick_fallback != blank -%}
            <img
              src="{{ pick_fallback | asset_url }}"
              alt="{{ pick_title | escape }}"
              width="900"
              height="600"
              loading="lazy"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
            >
          {%- endif -%}

          <div class="kixro-pick-card__overlay"></div>

          <div class="kixro-pick-card__content">
            {%- if pick_label != blank -%}
              <span class="kixro-pick-card__label">{{ pick_label }}</span>
            {%- endif -%}
            <span class="kixro-pick-card__title">{{ pick_title }}</span>
            <span class="kixro-btn kixro-btn--white kixro-btn--sm" style="display:inline-flex;">
              {{ pick_btn }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-discover-picks.name",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-discover-picks.settings.eyebrow.label",
      "default": "Curated For You"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-discover-picks.settings.heading.label",
      "default": "Discover Our Picks"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.kixro-discover-picks.settings.subtitle.label",
      "default": "Four curated worlds. One signature style."
    }
  ],
  "blocks": [
    {
      "type": "pick",
      "name": "t:sections.kixro-discover-picks.blocks.pick.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.image.label"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.fallback_image.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.label.label",
          "default": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.title.label",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.btn_label.label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.kixro-discover-picks.blocks.pick.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-discover-picks.presets.name",
      "blocks": [
        {
          "type": "pick",
          "settings": {
            "fallback_image": "pick-new-arrivals.png",
            "label": "Just In",
            "title": "New Arrivals",
            "btn_label": "Shop New Arrivals"
          }
        },
        {
          "type": "pick",
          "settings": {
            "fallback_image": "pick-best-sellers.png",
            "label": "Fan Favourites",
            "title": "Best Sellers",
            "btn_label": "Shop Best Sellers"
          }
        },
        {
          "type": "pick",
          "settings": {
            "fallback_image": "pick-trending-now.png",
            "label": "Right Now",
            "title": "Trending Now",
            "btn_label": "See What's Trending"
          }
        },
        {
          "type": "pick",
          "settings": {
            "fallback_image": "pick-kixro-essentials.png",
            "label": "Must Haves",
            "title": "Curated Essentials",
            "btn_label": "Shop Essentials"
          }
        }
      ]
    }
  ]
}
{% endschema %}
