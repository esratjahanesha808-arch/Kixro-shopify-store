<div class="kixro-brand-cta-outer color-{{ section.settings.color_scheme }}">
<div class="kixro-brand-cta">
  <div class="kixro-brand-cta__bg">
    {%- if section.settings.bg_image != blank -%}
      <img
        src="{{ section.settings.bg_image | image_url: width: 1920 }}"
        srcset="{{ section.settings.bg_image | image_url: width: 768 }} 768w,
                {{ section.settings.bg_image | image_url: width: 1440 }} 1440w,
                {{ section.settings.bg_image | image_url: width: 1920 }} 1920w"
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        width="1920" height="800"
      >
    {%- elsif section.settings.bg_fallback != blank -%}
      <img
        src="{{ section.settings.bg_fallback | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        width="1920" height="800"
      >
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,var(--kixro-primary) 0%,var(--kixro-primary-hover) 100%);"></div>
    {%- endif -%}
  </div>

  <div class="kixro-brand-cta__overlay" style="background:rgba(5,22,37,{{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>

  <div class="kixro-brand-cta__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kixro-brand-cta__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h2 class="kixro-brand-cta__heading">{{ section.settings.heading }}</h2>

    {%- if section.settings.subtext != blank -%}
      <p style="font-family:var(--kixro-font-body);font-size:var(--kixro-text-body-lg);color:rgba(255,255,255,0.75);line-height:var(--kixro-lh-relaxed);margin:0 0 var(--kixro-xl);">
        {{ section.settings.subtext }}
      </p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="kixro-btn kixro-btn--white kixro-btn--lg">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>
</div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-brand-cta.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:sections.kixro-brand-cta.settings.bg_image.label"
    },
    {
      "type": "text",
      "id": "bg_fallback",
      "label": "t:sections.kixro-brand-cta.settings.bg_fallback.label",
      "default": "banner-cta.png"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.kixro-brand-cta.settings.overlay_opacity.label",
      "min": 30,
      "max": 90,
      "step": 5,
      "default": 70
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-brand-cta.settings.eyebrow.label",
      "default": "Our Promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-brand-cta.settings.heading.label",
      "default": "Build Your Style With Confident Steps."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "t:sections.kixro-brand-cta.settings.subtext.label"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "t:sections.kixro-brand-cta.settings.btn_label.label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "t:sections.kixro-brand-cta.settings.btn_url.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-brand-cta.presets.name"
    }
  ]
}
{% endschema %}
