{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-contact section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="kixro-container">
    <div class="kixro-page-header kixro-page-header--compact">
      <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
      <h1 class="kixro-page-header__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="kixro-page-header__text">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="kixro-contact__grid">
      <div class="kixro-contact__form-wrap">
        {%- form 'contact', id: 'KixroContactForm', class: 'kixro-contact__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="kixro-contact__success" role="status">
              <p>{{ section.settings.success_message }}</p>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="kixro-contact__error" role="alert">
              <p>{{ section.settings.error_message }}</p>
            </div>
          {%- endif -%}

          <div class="kixro-contact__field">
            <label class="kixro-contact__label" for="ContactForm-name-{{ section.id }}">{{ section.settings.name_label }}</label>
            <input
              class="kixro-contact__input"
              type="text"
              id="ContactForm-name-{{ section.id }}"
              name="contact[name]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              required
            >
          </div>

          <div class="kixro-contact__field">
            <label class="kixro-contact__label" for="ContactForm-email-{{ section.id }}">{{ section.settings.email_label }}</label>
            <input
              class="kixro-contact__input"
              type="email"
              id="ContactForm-email-{{ section.id }}"
              name="contact[email]"
              autocomplete="email"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </div>

          <div class="kixro-contact__field">
            <label class="kixro-contact__label" for="ContactForm-body-{{ section.id }}">{{ section.settings.message_label }}</label>
            <textarea
              class="kixro-contact__input kixro-contact__textarea"
              id="ContactForm-body-{{ section.id }}"
              name="contact[body]"
              rows="6"
              required
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="kixro-btn kixro-btn--primary kixro-btn--lg">
            {{ section.settings.submit_label }}
          </button>
        {%- endform -%}
      </div>

      <aside class="kixro-contact__info">
        <h2 class="kixro-contact__info-title">{{ section.settings.info_heading }}</h2>
        {%- if section.settings.info_text != blank -%}
          <p class="kixro-contact__info-text">{{ section.settings.info_text }}</p>
        {%- endif -%}

        <ul class="kixro-contact__details">
          {%- if section.settings.email != blank -%}
            <li>
              <span class="kixro-contact__detail-label">Email</span>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>
              <span class="kixro-contact__detail-label">Phone</span>
              <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">{{ section.settings.phone }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li>
              <span class="kixro-contact__detail-label">Hours</span>
              <span>{{ section.settings.hours }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <li>
              <span class="kixro-contact__detail-label">Address</span>
              <span>{{ section.settings.address | newline_to_br }}</span>
            </li>
          {%- endif -%}
        </ul>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-contact-page.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-contact-page.settings.eyebrow.label",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-contact-page.settings.heading.label",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:sections.kixro-contact-page.settings.intro.label",
      "default": "Have a question about your order, sizing, or our collection? We're here to help."
    },
    {
      "type": "header",
      "content": "t:sections.kixro-contact-page.settings.header_1.content"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "t:sections.kixro-contact-page.settings.name_label.label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "t:sections.kixro-contact-page.settings.email_label.label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "t:sections.kixro-contact-page.settings.message_label.label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "t:sections.kixro-contact-page.settings.submit_label.label",
      "default": "Send Message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "t:sections.kixro-contact-page.settings.success_message.label",
      "default": "Thanks for reaching out. We'll get back to you shortly."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "t:sections.kixro-contact-page.settings.error_message.label",
      "default": "Please check your details and try again."
    },
    {
      "type": "header",
      "content": "t:sections.kixro-contact-page.settings.header_2.content"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "t:sections.kixro-contact-page.settings.info_heading.label",
      "default": "Customer Support"
    },
    {
      "type": "textarea",
      "id": "info_text",
      "label": "t:sections.kixro-contact-page.settings.info_text.label",
      "default": "Our team typically responds within 1–2 business days."
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.kixro-contact-page.settings.email.label",
      "default": "support@example.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.kixro-contact-page.settings.phone.label",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "t:sections.kixro-contact-page.settings.hours.label",
      "default": "Mon–Fri, 9am–6pm EST"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:sections.kixro-contact-page.settings.address.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-contact-page.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-contact-page.settings.padding_bottom.label",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-contact-page.presets.name"
    }
  ]
}
{% endschema %}
