{%- comment -%}
  Renders Shopify native policy pages (/policies/*) with Kixro styling.
{%- endcomment -%}

{%- liquid
  assign active_policy = nil

  for policy in shop.policies
    if policy.url == request.path
      assign active_policy = policy
      break
    endif
  endfor

  if active_policy == blank
    if shop.privacy_policy != blank and request.path == shop.privacy_policy.url
      assign active_policy = shop.privacy_policy
    elsif shop.refund_policy != blank and request.path == shop.refund_policy.url
      assign active_policy = shop.refund_policy
    elsif shop.shipping_policy != blank and request.path == shop.shipping_policy.url
      assign active_policy = shop.shipping_policy
    elsif shop.terms_of_service != blank and request.path == shop.terms_of_service.url
      assign active_policy = shop.terms_of_service
    endif
  endif
-%}

<div class="kixro-policy-page section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="kixro-container kixro-policy-page__inner">
    <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
    {%- if active_policy != blank -%}
      <h1 class="kixro-policy-page__title">{{ active_policy.title }}</h1>
      <div class="kixro-policy-page__body rte">{{ active_policy.body }}</div>
    {%- else -%}
      <h1 class="kixro-policy-page__title">Policy</h1>
      <div class="kixro-policy-page__body rte">
        <p>{{ section.settings.empty_message }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.kixro-shopify-policy.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-shopify-policy.settings.eyebrow.label",
      "default": "Help & Legal"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "t:sections.kixro-shopify-policy.settings.empty_message.label",
      "default": "Policy content has not been added yet. Please add it in Shopify Admin → Settings → Policies."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-shopify-policy.settings.padding_top.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-shopify-policy.settings.padding_bottom.label",
      "default": 64
    }
  ]
}
{% endschema %}
