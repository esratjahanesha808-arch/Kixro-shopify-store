<div class="kixro-about-cta-outer">
  <div class="kixro-about-cta">
    <div class="kixro-about-cta__bg" aria-hidden="true">
      {%- if section.settings.banner_image != blank -%}
        {{
          section.settings.banner_image
          | image_url: width: 1920
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1280px) 1280px, 100vw',
            widths: '768, 1200, 1920',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ 'about-cta-banner.png' | asset_url }}"
          alt=""
          loading="lazy"
          width="1920"
          height="800"
        >
      {%- endif -%}
    </div>
    <div class="kixro-about-cta__overlay" aria-hidden="true"></div>

    <div class="kixro-about-cta__inner">
      <h2 class="kixro-about-cta__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="kixro-about-cta__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="kixro-about-cta__actions">
        {%- if section.settings.btn_primary_label != blank -%}
          <a href="{{ section.settings.btn_primary_url | default: '/collections/all' }}" class="kixro-btn kixro-btn--white kixro-btn--lg">
            {{ section.settings.btn_primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn_secondary_label != blank -%}
          <a href="{{ section.settings.btn_secondary_url | default: '/collections/all' }}" class="kixro-btn kixro-btn--secondary kixro-btn--lg kixro-about-cta__btn-secondary">
            {{ section.settings.btn_secondary_label }}
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.seo_text != blank -%}
        <p class="kixro-about-cta__seo">{{ section.settings.seo_text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kixro About CTA",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to upgrade your footwear?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Discover the perfect pair that combines premium style and all-day comfort."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary button label",
      "default": "Shop All Shoes"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary button label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    },
    {
      "type": "textarea",
      "id": "seo_text",
      "label": "SEO supporting text",
      "default": "Looking for premium men's footwear designed with modern style and everyday comfort in mind? Discover Kixro's collection of shoes, boots, loafers, and sandals crafted for young men who value confidence and style."
    }
  ],
  "presets": [{ "name": "Kixro About CTA" }]
}
{% endschema %}
