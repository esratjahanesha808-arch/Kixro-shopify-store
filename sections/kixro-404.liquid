{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-404 color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="kixro-container kixro-404__inner">
    <p class="kixro-404__code">{{ section.settings.error_code }}</p>
    <h1 class="kixro-404__title">{{ section.settings.heading }}</h1>
    <p class="kixro-404__text">{{ section.settings.text }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" class="kixro-search__form kixro-404__search">
      <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'general.search.search' | t | default: 'Search' }}</label>
      <input
        class="kixro-search__input"
        id="Search-{{ section.id }}"
        type="search"
        name="q"
        placeholder="{{ section.settings.search_placeholder }}"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="kixro-btn kixro-btn--primary">{{ section.settings.search_button }}</button>
    </form>

    <div class="kixro-404__actions">
      <a href="{{ routes.root_url }}" class="kixro-btn kixro-btn--primary kixro-btn--lg">{{ section.settings.home_button }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="kixro-btn kixro-btn--secondary kixro-btn--lg">{{ section.settings.shop_button }}</a>
    </div>

    {%- if section.settings.show_links -%}
      <ul class="kixro-404__links">
        <li><a href="/pages/about-us">About Us</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-404.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "error_code",
      "label": "t:sections.kixro-404.settings.error_code.label",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-404.settings.heading.label",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.kixro-404.settings.text.label",
      "default": "The page you're looking for doesn't exist or has been moved. Try searching or head back to the shop."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "t:sections.kixro-404.settings.search_placeholder.label",
      "default": "Search products..."
    },
    {
      "type": "text",
      "id": "search_button",
      "label": "t:sections.kixro-404.settings.search_button.label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "home_button",
      "label": "t:sections.kixro-404.settings.home_button.label",
      "default": "Back to Home"
    },
    {
      "type": "text",
      "id": "shop_button",
      "label": "t:sections.kixro-404.settings.shop_button.label",
      "default": "Shop All"
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "t:sections.kixro-404.settings.show_links.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-404.settings.padding_top.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.kixro-404.settings.padding_bottom.label",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-404.presets.name"
    }
  ]
}
{% endschema %}
