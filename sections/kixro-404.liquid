{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="kixro-404 section-{{ section.id }}-padding">
  <div class="kixro-container kixro-404__inner">
    <p class="kixro-404__code">{{ section.settings.error_code }}</p>
    <h1 class="kixro-404__title">{{ section.settings.heading }}</h1>
    <p class="kixro-404__text">{{ section.settings.text }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" class="kixro-search__form kixro-404__search">
      <label class="visually-hidden" for="Kixro404Search">Search</label>
      <input
        class="kixro-search__input"
        id="Kixro404Search"
        type="search"
        name="q"
        placeholder="{{ section.settings.search_placeholder }}"
      >
      <input type="hidden" name="type" value="product">
      <button type="submit" class="kixro-btn kixro-btn--primary">{{ section.settings.search_button }}</button>
    </form>

    <div class="kixro-404__actions">
      <a href="{{ routes.root_url }}" class="kixro-btn kixro-btn--primary kixro-btn--lg">{{ section.settings.home_button }}</a>
      <a href="{{ routes.all_products_collection_url }}" class="kixro-btn kixro-btn--secondary kixro-btn--lg">{{ section.settings.shop_button }}</a>
    </div>

    {%- if section.settings.show_links -%}
      <ul class="kixro-404__links">
        <li><a href="/pages/about-us">About Us</a></li>
        <li><a href="/pages/contact">Contact</a></li>
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kixro 404 Page",
  "settings": [
    {
      "type": "text",
      "id": "error_code",
      "label": "Error code",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "The page you're looking for doesn't exist or has been moved. Try searching or head back to the shop."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search for shoes..."
    },
    {
      "type": "text",
      "id": "search_button",
      "label": "Search button",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "home_button",
      "label": "Home button",
      "default": "Back to Home"
    },
    {
      "type": "text",
      "id": "shop_button",
      "label": "Shop button",
      "default": "Shop All Shoes"
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "Show quick links",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [{ "name": "Kixro 404 Page" }]
}
{% endschema %}
