<div class="kixro-about-story color-{{ section.settings.color_scheme }}">
  <div class="kixro-container">
    <div class="kixro-about-story__grid">
      <div class="kixro-about-story__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'kixro-about-story__img',
              loading: 'lazy',
              sizes: '(min-width: 1024px) 440px, 100vw',
              widths: '400, 600, 900',
              alt: section.settings.heading
          }}
        {%- else -%}
          <img
            class="kixro-about-story__img"
            src="{{ 'category-shoes.png' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="900"
            height="900"
          >
        {%- endif -%}
      </div>

      <div class="kixro-about-story__content">
        <span class="kixro-section-label">{{ section.settings.eyebrow }}</span>
        <h2 class="kixro-section-title kixro-about-story__title">{{ section.settings.heading }}</h2>
        <div class="kixro-about-story__text rte">
          {{ section.settings.story }}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-about-story.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.kixro-about-story.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-about-story.settings.eyebrow.label",
      "default": "Brand Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-about-story.settings.heading.label",
      "default": "Modern style meets everyday comfort"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "t:sections.kixro-about-story.settings.story.label",
      "default": "<p>Welcome to our brand, where modern style meets everyday comfort. Born from a passion for premium craftsmanship, we design products for those who demand more — more style, more confidence, and more comfort, from morning to night.</p><p>We believe that great design transforms confidence, elevates personal style, and carries you through every moment with ease. That's why we craft every piece with precision, premium materials, and modern silhouettes that feel as good as they look.</p><p>Our collection is more than just fashion — it's a statement of intentional living. For the trendsetters, the go-getters, and the style-conscious who walk their own path, we are your perfect companion for every step of the journey.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-about-story.presets.name"
    }
  ]
}
{% endschema %}
