<div class="kixro-about-hero color-{{ section.settings.color_scheme }}">
  <div class="kixro-about-hero__media" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag:
          class: 'kixro-about-hero__img',
          loading: 'eager',
          sizes: '100vw',
          widths: '750, 1100, 1500, 2000',
          alt: ''
      }}
    {%- else -%}
      <img
        class="kixro-about-hero__img"
        src="{{ 'hero-2.png' | asset_url }}"
        alt=""
        loading="eager"
        width="2000"
        height="800"
      >
    {%- endif -%}
    <div class="kixro-about-hero__overlay"></div>
  </div>

  <div class="kixro-container kixro-about-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kixro-about-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="kixro-about-hero__title">{{ section.settings.heading }}</h1>
    <span class="kixro-about-hero__rule" aria-hidden="true"></span>
    {%- if section.settings.subheading != blank -%}
      <p class="kixro-about-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.kixro-about-hero.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.kixro-about-hero.settings.background_image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.kixro-about-hero.settings.eyebrow.label",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.kixro-about-hero.settings.heading.label",
      "default": "Step into Confidence"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.kixro-about-hero.settings.subheading.label",
      "default": "Quality craftsmanship designed for everyday life and timeless style."
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-about-hero.presets.name"
    }
  ]
}
{% endschema %}
