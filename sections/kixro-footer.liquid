      "label": "t:sections.kixro-footer.settings.sitemap_heading.label",
      "default": "Site Map"
    },
    {
      "type": "link_list",
      "id": "sitemap_menu",
      "label": "t:sections.kixro-footer.settings.sitemap_menu.label",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.kixro-footer.settings.header_2.content"
    },
    {
      "type": "text",
      "id": "legal_heading",
      "label": "t:sections.kixro-footer.settings.legal_heading.label",
      "default": "Help & Legal"
    },
    {
      "type": "text",
      "id": "about_us_url",
      "label": "t:sections.kixro-footer.settings.about_us_url.label",
      "default": "/pages/about-us",
      "info": "t:sections.kixro-footer.settings.about_us_url.info"
    },
    {
      "type": "text",
      "id": "about_us_label",
      "label": "t:sections.kixro-footer.settings.about_us_label.label",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "refund_policy_label",
      "label": "t:sections.kixro-footer.settings.refund_policy_label.label",
      "default": "Return & Refund Policy"
    },
    {
      "type": "text",
      "id": "refund_policy_url",
      "label": "t:sections.kixro-footer.settings.refund_policy_url.label",
      "info": "t:sections.kixro-footer.settings.refund_policy_url.info"
    },
    {
      "type": "text",
      "id": "shipping_policy_label",
      "label": "t:sections.kixro-footer.settings.shipping_policy_label.label",
      "default": "Shipping Policy"
    },
    {
      "type": "text",
      "id": "shipping_policy_url",
      "label": "t:sections.kixro-footer.settings.shipping_policy_url.label",
      "info": "t:sections.kixro-footer.settings.shipping_policy_url.info"
    },
    {
      "type": "text",
      "id": "privacy_policy_label",
      "label": "t:sections.kixro-footer.settings.privacy_policy_label.label",
      "default": "Privacy Policy"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_policy",
      "label": "t:sections.kixro-footer.settings.show_privacy_policy.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_terms_policy",
      "label": "t:sections.kixro-footer.settings.show_terms_policy.label",
      "default": true
    },
    {
      "type": "text",
      "id": "terms_policy_label",
      "label": "t:sections.kixro-footer.settings.terms_policy_label.label",
      "default": "Terms of Service"
    },
    {
      "type": "text",
      "id": "terms_policy_url",
      "label": "t:sections.kixro-footer.settings.terms_policy_url.label",
      "info": "t:sections.kixro-footer.settings.terms_policy_url.info"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "t:sections.kixro-footer.settings.legal_menu.label"
    },
    {
      "type": "header",
      "content": "t:sections.kixro-footer.settings.header_3.content"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "t:sections.kixro-footer.settings.show_back_to_top.label",
      "default": true
    },
    {
      "type": "text",
      "id": "back_to_top_label",
      "label": "t:sections.kixro-footer.settings.back_to_top_label.label",
      "default": "Back to top"
    }
  ],
  "presets": [
    {
      "name": "t:sections.kixro-footer.presets.name"
